'use strict';

/**
 * start.js — /start command + Reply Keyboard Layout
 *
 * Exports:
 *   registerStart(bot)         — Register /start command
 *   buildDashboardText(name)   — Build bot status text for dashboard/refresh
 *   sendOrEditDashboard(ctx, text) — Send or edit dashboard message with keyboard
 */

const { Markup } = require('telegraf');

// ─── Reply Keyboard Layout ────────────────────────────────────────────────────
// PENTING: label tombol di sini HARUS SAMA PERSIS dengan string di bot.hears()
// di _src_bot_index.js — termasuk emoji dan spasi.

const mainKeyboard = Markup.keyboard([
  ['📊 Market',           '📈 Statistik'],
  ['📅 Daily',            '📅 Weekly'],
  ['📖 Journal',          '🤖 Bot Status'],
  ['🧠 Learning',         '🔄 Retrain'],
  ['👀 Watchlist',        '❓ Kenapa Belum Entry?'],
  ['📚 Strategi Stats',   '📉 Backtest 7D'],
  ['📊 Backtest 30D',     '📄 Export Excel'],
  ['💼 Money Management', '👤 Profile'],
  ['🟢 Force BUY',        '🔴 Force SELL'],
  ['🔭 Trade Scanner',    '📡 Scan Status'],
  ['📰 News',             '📑 Export PDF'],
  ['🔄 Refresh',          '❓ Bantuan'],
]).resize();

// ─── Build dashboard/status text ─────────────────────────────────────────────
async function buildDashboardText(name = 'Trader') {
  try {
    const { getOpenSignals, getLastSignalTime } = require('../../database/db');
    const { toWIB } = require('../../utils/wib_time');

    const openSignals = await getOpenSignals();
    const lastSignal  = await getLastSignalTime();
    const interval    = parseInt(process.env.SCAN_INTERVAL || '60000') / 1000;
    const wib         = toWIB();

    const openLines = openSignals.length > 0
      ? openSignals.slice(0, 3).map((s) =>
          `  • ${s.direction} @ ${s.entry} (${s.confidence}%)`
        ).join('\n')
      : '  Tidak ada sinyal terbuka.';

    let lastSignalWib = 'Belum ada sinyal';
    if (lastSignal) {
      const lsw = toWIB(new Date(lastSignal));
      lastSignalWib = `${lsw.dateNum} ${lsw.month} ${lsw.year} ${lsw.hours}:${lsw.minutes} WIB`;
    }

    return [
      `🔍 <b>AZZAVISION AI — BOT STATUS</b>`,
      ``,
      `━━━━━━━━━━━━━━━━━━`,
      `🟢 Status    : ONLINE & AKTIF`,
      `📡 Interval  : <code>${interval}s</code>`,
      `🎯 Min Conf  : <code>${process.env.MIN_CONFIDENCE || '65'}%</code>`,
      ``,
      `━━━━━━━━━━━━━━━━━━`,
      `📌 <b>OPEN SIGNALS (${openSignals.length})</b>`,
      openLines,
      ``,
      `━━━━━━━━━━━━━━━━━━`,
      `🕐 Sinyal Terakhir: ${lastSignalWib}`,
      ``,
      wib.line,
      ``,
      `🪙 Pair: XAUUSD  |  💾 DB: JSON Storage`,
      `⚡ <i>AZZAVISION AI v3.2.1 — Auto Gold Signals</i>`,
    ].join('\n');

  } catch (err) {
    const { toWIB } = require('../../utils/wib_time');
    const wib = toWIB();
    return [
      `🔍 <b>AZZAVISION AI — BOT STATUS</b>`,
      ``,
      `🟢 Status : ONLINE`,
      wib.line,
      ``,
      `⚡ <i>AZZAVISION AI — Auto Gold Signals</i>`,
    ].join('\n');
  }
}

// ─── Send or edit dashboard message ──────────────────────────────────────────
async function sendOrEditDashboard(ctx, text) {
  // Selalu kirim pesan baru dengan keyboard (tidak edit — keyboard perlu dikirim ulang)
  await ctx.replyWithHTML(text, mainKeyboard);
}

// ─── Register /start ──────────────────────────────────────────────────────────
function registerStart(bot) {
  bot.command('start', async (ctx) => {
    const name = ctx.from?.first_name || 'Trader';
    try {
      const text = await buildDashboardText(name);
      await ctx.replyWithHTML(text, mainKeyboard);
    } catch (err) {
      await ctx.replyWithHTML(
        `👋 Halo, <b>${name}</b>! Selamat datang di AZZAVISION AI.\n\nGunakan menu keyboard di bawah atau ketik /help.`,
        mainKeyboard
      );
    }
  });
}

module.exports = { registerStart, buildDashboardText, sendOrEditDashboard };
